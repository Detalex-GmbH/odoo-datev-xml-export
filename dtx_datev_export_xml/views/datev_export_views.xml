<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="datev_export_view_kanban" model="ir.ui.view">
        <field name="name">datev.export.xml.kanban</field>
        <field name="model">datev.export.xml</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="create_date" />
                <field name="create_uid" />
                <field name="date_stop" />
                <field name="invoices_count" />
                <field name="date_start" />
                <field name="state" />
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb8">
                                <div class="o_kanban_record_headings mt4">
                                    Erstellt am <strong class="">
                                        <field name="create_date" />
                                        von
                                        <field name="create_uid" />
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <strong>Period:
                                </strong>
                                <div>
                                    <field name="date_start" />
                                    -
                                    <field name="date_stop" />
                                </div>

                                <div>
                                    <strong> Exportiert:
                                    </strong>
                                    (<field name="invoices_count" />)

                                    Dokument(en)
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mb4">
                                <div class="oe_kanban_bottom_left text-muted">

                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field
                                        name="state"
                                        widget="label_selection"
                                        options="{'classes': {'pending': 'default', 'running': 'info', 'done': 'success', 'failed': 'danger'}}"
                                    />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_datev_export_form" model="ir.ui.view">
        <field name="name">datev.export.xml.form</field>
        <field name="model">datev.export.xml</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form create="1">
                <header>
                    <!-- Run in Background buttons -->
                    <button
                        name="action_draft"
                        type="object"
                        string="Set to draft"
                        invisible="state in ['draft']"
                        confirm="Do you really want to set the export to draft?"
                        class="oe_highlight"
                    />
                    <button
                        name="action_validate"
                        type="object"
                        string="Validate"
                        invisible = "state in ['draft'] or invoices_count == 0"
                        confirm="Do you really want to validate the export?"
                    />
                    <button
                        name="create_zip"
                        context="{'recreate': True}"
                        type="object"
                        string="Create Export File"
                        invisible = "state not in ['draft']"
                        confirm="Do you really want to create the export?"
                        class="oe_highlight"
                    />
                    <button
                        name="create_zip"
                        context="{'recreate': False}"
                        type="object"
                        string="Recreate Export File"
                        invisible="state not in ['done', 'failed'] or invoices_count == 0 or datev_file == False"
                        confirm="Do you really want to restart the export?"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,running,done"
                        statusbar_colors="{'done':'blue', 'failed':'red'}"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button oe_read_only"
                            name="action_show_related_invoices_view"
                            icon="fa-usd"
                            type="object"
                        >
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="invoices_count" />
                                </span>
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                        <button
                            class="oe_stat_button magic-error-button"
                            name="action_show_invalid_invoices_view"
                            icon="fa-exclamation-triangle"
                            type="object"
                            invisible="problematic_invoices_count == 0"
                            title="🚨 Direkt zu den Validierungsfehlern springen!"
                            style="animation: pulse 2s infinite; background: linear-gradient(45deg, #ff6b6b, #ee5a24);"
                        >
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    🚨 <field name="problematic_invoices_count" />
                                </span>
                                <span class="o_stat_text">Validierungsfehler</span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group
                            string="Time Filters"
                        >
                            <field name="date_start" readonly="state != 'draft'" />
                            <field name="date_stop" readonly="state != 'draft'" />
                        </group>
                        <group string="Dokumententypen">
                            <field name="include_out_invoice" readonly="state != 'draft'" />
                            <field name="include_out_refund" readonly="state != 'draft'" />
                            <field name="include_in_invoice" readonly="state != 'draft'" />
                            <field name="include_in_refund" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group>
                        <group string="General Settings">
                            <field name="check_xsd" readonly="state != 'draft'" />
                            <field name="export_bu_code" readonly="state != 'draft'" />
                            <div class="alert alert-info" role="alert" style="margin-bottom: 4px;">
                                <h4 class="alert-heading">
                                    <i class="fa fa-info-circle"/> DATEV Buchungscode (BU-Code) exportieren?
                                </h4>
                                <p class="mb-0">
                                    <strong>⚠️ Wichtig:</strong> Sprechen Sie mit Ihrer Steuerkanzlei, bevor Sie diese Option aktivieren!
                                </p>
                                <hr style="margin: 8px 0;"/>
                                <ul style="margin-bottom: 0; padding-left: 20px;">
                                    <li>
                                        <strong>Deaktiviert (empfohlen):</strong> DATEV ordnet Steuern automatisch zu
                                    </li>
                                    <li>
                                        <strong>Aktiviert:</strong> DATEV nutzt die in Odoo hinterlegten BU-Codes
                                    </li>
                                </ul>
                                <p style="margin-top: 8px; margin-bottom: 0;">
                                    <i class="fa fa-book"/> 
                                    <a href="https://github.com/Detalex-GmbH/odoo-datev-xml-export/blob/18.0/dtx_datev_export/README_BU_CODE.md" target="_blank">
                                        Ausführliche Dokumentation
                                    </a>
                                </p>
                            </div>
                        </group>
                        <group string="Download File" col="1">
                            <field name="datev_filename" invisible="1" />
                            <div>
                                <span
                                    invisible="datev_file != False"
                                >
                                    <strong>
                                        <big>
                                            The zip file can be downloaded here after creation!
                                        </big>
                                    </strong>
                                </span>
                                <span
                                    invisible="datev_file == False"
                                >
                                    <span>
                                        <big>
                                            <big>
                                                <field
                                                    name="datev_file"
                                                    filename="datev_filename"
                                                    nolabel="1"
                                                />
                                                <i class="ml8"><field name="datev_filesize"/>
                                                </i>
                                            </big>
                                        </big>
                                    </span>
                                </span>
                            </div>
                        </group>
                    </group>

                    <group
                        string="Exception Info"
                        name="exception_info"
                        invisible="exception_info == False"
                    >
                        <field
                            name="exception_info"
                            nolabel="1"
                            colspan="2"
                            class="alert alert-danger"
                            role="alert"
                        />
                    </group>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_datev_export_popup_form" model="ir.ui.view">
        <field name="name">datev.export.xml.popup.form</field>
        <field name="model">datev.export.xml</field>
        <field name="priority">50</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="view_datev_export_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <header position="attributes">
                <attribute name="invisible">1</attribute>
            </header>

            <sheet position="inside">
                <footer>
                    <!-- Run in Background buttons -->
                    <button
                        string="Create Export File"
                        name="export_zip"
                        type="object"
                        class="oe_highlight"
                        invisible="datev_file != False"
                        confirm="The creation of the file will be done in background and may take some time! When the file is created or an exception occurs, an activity will be applied to you."
                    />

                    <button
                        string="Recreate Export File"
                        name="export_zip"
                        type="object"
                        class=""
                        invisible="datev_file == False or invoices_count == 0"
                        confirm="Do you really want to create the DATEV file again? The creation of the file will be done in background and may take some time! When the file is created or an exception occurs, an activity will be applied to you."
                    />

                    <!-- Run in Foreground buttons -->
                    <button
                        string="Create Export File"
                        name="export_zip"
                        type="object"
                        class="oe_highlight"
                        invisible="datev_file != False or invoices_count == 0"
                        confirm="The creation of the file can take some time! Do you really want to proceed!"
                    />

                    <!-- Special Buttons -->
                    <button string="Close" class="oe_link" special="cancel" />
                </footer>
            </sheet>
        </field>
    </record>

    <record id="action_datev_export_wizard" model="ir.actions.act_window">
        <field name="name">DATEV XML Export Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">datev.export.xml</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_datev_export_popup_form" />
        <field name="target">new</field>
    </record>

    <record id="datev_export_view_list" model="ir.ui.view">
        <field name="name">datev.export.xml.view.list</field>
        <field name="model">datev.export.xml</field>
        <field name="arch" type="xml">
            <list
                create="1"
                default_order="id desc"
                decoration-muted="state in ['draft', 'pending']"
                decoration-danger="state == 'failed'"
                decoration-success="state == 'running'"
            >
                <field name="create_date" />
                <field name="create_uid" />
                <field name="date_start" />
                <field name="date_stop" />
                <field name="datev_file" filename="datev_filename" widget="binary" />
                <field name="invoices_count" string="Dokumenten" />
                <field name="state" />
            </list>
        </field>
    </record>


    <record id="action_datev_export" model="ir.actions.act_window">
        <field name="name">DATEV XML Export</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">datev.export.xml</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'bin_size': True}</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                <!-- Add Text Here -->
            </p>
            <p>
                <!-- More details about what a user can do with this object will be OK -->
            </p>
        </field>
    </record>

    <record id="action_invoice_datev_export" model="ir.actions.server">
        <field name="name">DATEV XML Export</field>
        <field name="model_id" ref="model_datev_export_xml" />
        <field name="state">code</field>
        <field name="code">action = model.export_zip_invoice()</field>
        <field name="binding_model_id" ref="account.model_account_move" />
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]" />
    </record>

</odoo>
